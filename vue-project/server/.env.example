DB_HOST=seu_host_aiven_aqui
DB_USER=seu_usuario_aqui
DB_PASSWORD=sua_senha_aqui
DB_NAME=seu_banco_de_dados_aqui
DB_PORT=20989

# Autenticação JWT
# Gere um segredo forte: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# CORS — origens permitidas, separadas por vírgula (ex: https://meusite.com,https://app.meusite.com)
# Se não definido em produção, o servidor exibirá aviso e bloqueará todas as origens (dev: permissivo)
ALLOWED_ORIGINS=
